#!/bin/sh
# Block a commit that changes the essay page or its sources without a version bump.
# Enable once per clone:  git config core.hooksPath .githooks
staged=$(git diff --cached --name-only)
watch='^essay/(part-[0-9]-(rational|spiritual|practical)\.(md|html)|build_html\.py|figs[0-9]*\.py|img/)'
if echo "$staged" | grep -Eq "$watch"; then
  if ! echo "$staged" | grep -qx 'VERSION'; then
    echo "The essay changed but VERSION did not."
    echo "Use: python tools/release.py {major|minor|fix} \"what changed\""
    exit 1
  fi
  v=$(tr -d '[:space:]' < VERSION)
  for page in essay/part-*-*.html; do
    case "$page" in *.fragment.html) continue;; esac
    if ! grep -q "name=\"version\" content=\"$v\"" "$page"; then
      echo "$page is not built for VERSION $v. Run: python essay/build_html.py"
      exit 1
    fi
  done
fi
exit 0
